# Keep text checkouts consistent with the repository formatter on every platform.
* text=auto eol=lf

# Windows command fixtures retain their native line endings.
*.cmd text eol=crlf

# Preserve whitespace in original upstream licensing texts.
licenses/npm-runtime-notices.txt whitespace=-blank-at-eol

# Runtime byte evidence must survive checkout without newline conversion.
docs/verification/rea-engine/*.bin -text
benchmarks/plink/replica/goldens/* -text
benchmarks/native-windows-ports/snake/original-run0.txt -text
benchmarks/native-windows-ports/pixeltetris/replica/assets/OFL.txt -text
