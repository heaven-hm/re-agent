          "kind": "decompiled-csharp",
          "language": "csharp",
          "text": "public static char CalculateLuhn(string str)\n\t{\n\t\tint num = 0;\n\t\tint num2 = str.Length & 1;\n\t\tforeach (char c in str)\n\t\t{\n\t\t\tif ((c >= '0' && c <= '9') || 1 == 0)\n\t\t\t{\n\t\t\t\tint num3 = c - 48 << num2;\n\t\t\t\tnum += num3 / 10 + num3 % 10;\n\t\t\t\tnum2 ^= 1;\n\t\t\t}\n\t\t}\n\t\tnum = (10 - num % 10) % 10;\n\t\treturn (char)(num + 48);\n\t}",
